# API key disarankan diatur pada panel hosting sebagai environment variable GEMINI_API_KEY.
# Untuk local development, masukkan key di file .env jika runtime hosting memuat file tersebut.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# YTA (YouTube audio) memakai yt-dlp yang diunduh otomatis ke ~/.cache/supanigabot.
# Opsional: pakai yt-dlp milik sistem.
YTDLP_PATH=
# Opsional: file cookies.txt YouTube bila hosting kena "Sign in to confirm you're not a bot".
YTDLP_COOKIES=
# Opsional: path ffmpeg sendiri (default: @ffmpeg-installer dari npm, ffmpeg sistem, atau unduh otomatis)
# FFMPEG_PATH=

# Pixiv: cookie sesi akun Pixiv (nilai PHPSESSID=...) untuk mode -adult.
# Akun harus mengizinkan konten R-18 di pengaturan Pixiv. Tanpa cookie, -adult ditolak.
PIXIV_COOKIE=
# Opsional: host mirror gambar sendiri bila jaringan hosting memblokir i.pximg.net
# (bot otomatis mencoba i.pixiv.re dan i.pixiv.nl).
PIXIV_IMAGE_PROXY=

# Shell admin (.shell dan panel Shell di dashboard). Isi 1 untuk menonaktifkan.
DISABLE_SHELL=
