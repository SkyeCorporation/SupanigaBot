# Semua opsional — menimpa nilai di config.json.
# Salin jadi .env (atau isi di panel hosting) bila perlu.

# Port dashboard (Pterodactyl otomatis memakai SERVER_PORT)
PORT=3000

# Sandi dashboard (disarankan diisi di hosting bila repo GitHub kamu publik)
DASHBOARD_PASSWORD=

# Prefix command
BOT_PREFIX=

# Gemini AI Esdeath (ambil API key dari Google AI Studio)
GEMINI_API_KEY=
# Model Flash yang digunakan; boleh diganti sesuai model yang tersedia di akun/API.
GEMINI_MODEL=gemini-2.5-flash

# Lokasi file database SQL
DATABASE_FILE=./database/supaniga.db
